# ──────── Runtime-generated by shai_hulud_guard ───────────
# These files are EMITTED BY the tool itself when users run it.
# They are intentionally NOT checked in:
#  - Diagnosis reports (may include hostnames, user/CI env, paths)
#  - GitHub Actions SHA-pinning audit reports (per-project output)
#  - Legacy v2.0 npm safe-install wrapper

# --diagnose output
shai_hulud_report_*.txt
# legacy v2.0 audit reports
shai_hulud_pin_actions.txt
npm_safe_install.py

# v2.4 --protect generated wrappers + templates (regenerate via --protect)
npm_safe.sh
npm_safe.ps1
pip_safe.sh
pip_safe.ps1
shai_hulud_pre_commit.hook

# v2.4 --patch remediation scripts
remove_daemon.sh
remove_daemon.ps1
clean_packages.sh
clean_packages.ps1

# v2.4 scheduled-scan log (Phase 2 of --protect)
shai_hulud_scan.log

# ─────────────── Local config / secrets ───────────────────
.env
.env.*
*.local

# ───────────── Claude Code local state ────────────────────
# Per-machine Claude Code permissions/settings — not portable, not for sharing.
.claude/

